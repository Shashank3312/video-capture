# Python
__pycache__/
*.pyc
.venv/
venv/
env/
.env

# Node / web frontend
node_modules/
dist/
build/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Secrets / local config
*.local
.env.*
!.env.example

# Personal photos/videos used to test face matching - this repo is
# public, never commit real people's images or footage.
track_b_video/test_data/

# Exported browser cookies for yt-dlp. These carry a live, signed-in
# YouTube session - anyone who got hold of one could act as that
# account. Never commit them, especially not to a public repo.
cookies.txt
*cookies*.txt

# Firebase service account key. This is a server credential that can
# send notifications as this project - it must never be committed.
# The web config and VAPID key are NOT secret and can be; this file is
# the one that matters.
#
# Ignore EVERY json at the repo root, not just the names Firebase
# happens to use. The named patterns below missed the real download,
# which arrived as "firebase admin SDK.json" - spaces, different case -
# and sat there committable. A credential file should not depend on
# guessing its name, and nothing at the root needs to be tracked json.
/*.json
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
*firebase*admin*.json

# Local job database and uploaded reference photos, both of which hold
# real people's data.
app/jobs.db
app/uploads/

# The Firebase web config is served from firebase-web-config.json
# (gitignored) by app/main.py, not from a tracked file. GitHub flags a
# Google API key wherever it appears, and an unrestricted one can be
# billed against on other Google APIs.
app/static/firebase-config.js
!firebase-web-config.example.json
