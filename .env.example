# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Free API key from https://cricketdata.org/signup.aspx
# (kept around from initial research; not the primary data source - see RAPIDAPI_KEY below)
CRICAPI_KEY=

# RapidAPI key, subscribed to the "Cricbuzz Cricket" API (by cricketapilive)
# at https://rapidapi.com/cricketapilive/api/cricbuzz-cricket - this is the
# real data source for Track A (has current batsman/bowler + squads).
RAPIDAPI_KEY=
